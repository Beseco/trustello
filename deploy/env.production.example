# Trustello — Production Environment
# Kopieren nach /opt/trustello/.env.production und Werte eintragen

# Datenbank (Docker-intern)
DATABASE_URL=postgresql://trustello:POSTGRES_PW_HIER@postgres:5432/trustello_prod

# Auth (generieren: openssl rand -base64 32)
AUTH_SECRET=GEHEIMNIS_HIER
AUTH_URL=https://app.trustello.de
NEXTAUTH_SECRET=GLEICHER_WERT_WIE_AUTH_SECRET
NEXTAUTH_URL=https://app.trustello.de

# Verschlüsselung (generieren: openssl rand -base64 32)
MASTER_KEY=MASTER_KEY_HIER

# PostgreSQL-Passwort (auch in docker-compose.prod.yml via POSTGRES_PASSWORD)
POSTGRES_PASSWORD=POSTGRES_PW_HIER

# Redis (generieren: openssl rand -hex 32)
REDIS_PASSWORD=REDIS_PW_HIER
REDIS_URL=redis://:REDIS_PW_HIER@redis:6379

# E-Mail SMTP (Mandanten-spezifisch — hier System-Fallback)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@trustello.de

# Hetzner Object Storage (S3-kompatibel)
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY=HETZNER_ACCESS_KEY
S3_SECRET_KEY=HETZNER_SECRET_KEY
S3_BUCKET=trustello-prod

# ClamAV (Docker-intern)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# App
NEXT_PUBLIC_APP_URL=https://app.trustello.de
LOG_LEVEL=info

# Cron-Authentifizierung (generieren: openssl rand -hex 32)
CRON_SECRET=CRON_SECRET_HIER

# sipgate SMS (optional)
SIPGATE_TOKEN_ID=
SIPGATE_TOKEN=
SIPGATE_SMS_ID=s0

# LetterXpress (optional — wird auch per UI konfiguriert)
LETTERXPRESS_USERNAME=
LETTERXPRESS_API_KEY=
