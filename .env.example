# Datenbank
DATABASE_URL=postgresql://trustello:trustello_dev_pw@localhost:5432/trustello_dev

# Auth
NEXTAUTH_SECRET=  # generieren mit: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Crypto (kritisch!)
MASTER_KEY=  # generieren mit: openssl rand -base64 32

# SMTP (lokal: Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
