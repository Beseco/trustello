# Datenbank
DATABASE_URL=postgresql://trustello:trustello_dev_pw@localhost:5432/trustello_dev

# Auth — NextAuth v5 benötigt AUTH_SECRET / AUTH_URL
AUTH_SECRET=  # generieren mit: openssl rand -base64 32
AUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=  # gleicher Wert wie AUTH_SECRET (Fallback)
NEXTAUTH_URL=http://localhost:3000

# Crypto (kritisch!)
MASTER_KEY=  # generieren mit: openssl rand -base64 32

# SMTP (lokal: Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@trustello.local

# Redis
REDIS_URL=redis://localhost:6379

# S3 / MinIO (lokal: MinIO auf Port 9000)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=trustello
S3_SECRET_KEY=trustello_dev_pw
S3_BUCKET=trustello-dev

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# App URL (für E-Mail-Links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Cron-Job Absicherung (optional, aber empfohlen in Production)
CRON_SECRET=

# sipgate SMS (Passwortübermittlung bei Stufe-3/4-Nachrichten)
# Optional: Kann alternativ im Reseller-Portal unter /reseller/settings/sipgate konfiguriert werden.
# Env-Variablen dienen als globaler Fallback, falls kein DB-Eintrag vorhanden ist.
SIPGATE_TOKEN_ID=token1234567890
SIPGATE_TOKEN=your-sipgate-token-secret
SIPGATE_SMS_ID=s0

# LetterXpress (PIN-Brief-Versand für postalische Konto-Verifizierung)
# Optional: Kann alternativ im Reseller-Portal unter /reseller/settings/letterxpress konfiguriert werden.
# Env-Variablen dienen als globaler Fallback, falls kein DB-Eintrag vorhanden ist.
LETTERXPRESS_USERNAME=
LETTERXPRESS_API_KEY=


# Outlook Add-in CORS — erlaubte Ursprünge (kommagetrennt)
# Standard: https://addin.trustello.de (in Produktion automatisch gesetzt)
# Für lokale Entwicklung: http://localhost:3001
ADDIN_ORIGIN=https://addin.trustello.de
